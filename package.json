{
  "name": "zana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "vite build",
    "build:worker": "echo 'Worker deployed via Wrangler'",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "verify:finalization": "node scripts/verify-finalization-contract.js",
    "predeploy:cloudflare": "node scripts/check-secrets.js",
    "deploy:cloudflare": "wrangler deploy",
    "predeploy": "node scripts/check-secrets.js",
    "deploy": "wrangler deploy",
    "test": "npm run verify:finalization && node --import tsx --import ./src/test/setupEnv.ts --test src/curriculum/curriculum.test.ts src/curriculum/ingestion/ingestion.test.ts src/curriculum/retrieval/retrieval.test.ts src/curriculum/grounding.test.ts src/curriculum/practice.test.ts src/learning/engine/AdaptiveLearningEngine.test.ts src/learning/providers/LearningSecurity.test.ts src/assessment/AssessmentIntelligence.test.ts src/planning/planning.test.ts src/worker/worker.test.ts src/test/resolve-kv.test.ts src/test/firebaseAndBoundaries.test.ts src/test/firebaseDataLayer.test.ts src/test/apiClientAndLocalStorage.test.ts src/test/internalBrainService.test.ts src/test/adminGuardAndSecurity.test.ts src/test/authService.test.ts src/test/durableAndPersistence.test.ts src/test/uiRtl.test.ts src/test/assessmentGrader.test.ts src/test/notificationSystem.test.ts src/test/subscriptionReceipts.test.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:architecture": "node --import tsx --import ./src/test/setupEnv.ts --test src/test/firebaseAndBoundaries.test.ts",
    "test:security": "node --import tsx --import ./src/test/setupEnv.ts --test src/learning/providers/LearningSecurity.test.ts",
    "test:rtl": "node --import tsx --import ./src/test/setupEnv.ts --test src/test/uiRtl.test.ts",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "typescript": "~5.8.2",
    "vite": "^6.4.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.22.4",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "^4.1.14",
    "terser": "^5.51.2",
    "tsx": "^4.21.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "1.20.9",
    "source-map-js": "1.2.4",
    "picomatch": "2.3.2",
    "nanoid": "3.3.20",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.6",
    "compression": "1.8.2",
    "qs": "6.17.1",
    "tar": "7.5.23",
    "csv-parse": "7.0.3",
    "basic-ftp": "6.2.6",
    "sharp": "0.35.5",
    "undici": "8.12.4",
    "stream-json": "3.9.0",
    "fast-xml-parser": "5.12.1",
