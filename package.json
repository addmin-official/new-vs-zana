    "hono": "4.13.19",
    "@hono/node-server": "2.1.9",
    "@modelcontextprotocol/sdk": "1.32.2",
    "re2": "1.27.2",
    "zod": "4.6.7",
    "@grpc/grpc-js": "1.14.7",
    "cross-spawn": "7.0.6",
    "micromatch": "4.0.8",
    "brace-expansion": "1.1.21",
    "minimatch": "11.0.9",
    "postcss": "8.5.33",
    "js-yaml": "4.3.2",
    "@opentelemetry/core": "2.12.1",
    "uuid": "11.1.1",
    "@eslint/config-array": {
      "brace-expansion": "5.0.13"
    },
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.13"
    },
    "eslint": {
      "brace-expansion": "5.0.13"
    },
    "glob": {
      "brace-expansion": "2.1.8"
    },
    "readdir-glob": {
      "brace-expansion": "2.1.8"
    },
    "superstatic": {
      "brace-expansion": "2.1.8"
    }
  }
}
