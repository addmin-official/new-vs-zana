{
  "name": "new-vs-zana",
  "observability": {
  "logs": {
    "enabled": true,
    "head_sampling_rate": 1,
    "invocation_logs": true,
    "persist": true
  },
  "traces": {
    "enabled": true,
    "head_sampling_rate": 1,
    "persist": true
  }
},
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-04-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://zana.krd,https://zana-api-worker.zana-platform.workers.dev",
    "GEMINI_PRIMARY_MODEL": "gemini-3.5-flash",
    "GEMINI_VISION_MODEL": "gemini-3.5-flash"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "LEARNING_RECORDS_KV"
    }
  ]
}
