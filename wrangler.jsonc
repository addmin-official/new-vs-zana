{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-vs-zana",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.env",
      "/.env.*",
      "/.dev.vars",
      "/.dev.vars.*",
      "/.git/*",
      "/.github/*",
      "/.firebaserc",
      "/firebase.json",
      "/firestore.rules",
      "/wrangler.jsonc",
      "/wrangler.toml",
      "/wrangler.production.json",
      "/wrangler.production.jsonc",
      "/tsconfig.json",
      "/vite.config.ts",
      "/vite.config.js",
      "/package.json",
      "/package-lock.json",
      "/bun.lock",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/src/*",
      "/scripts/*",
      "/coverage/*",
      "/dist/server/*",
      "/assets/*.map",
      "/*.map"
    ]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://zana.krd,https://new-vs-zana.zana-platform.workers.dev",
    "GEMINI_PRIMARY_MODEL": "gemini-3.6-flash",
    "GEMINI_VISION_MODEL": "gemini-3.6-flash",
    "FIREBASE_PROJECT_ID": "gen-lang-client-0009572581",
    "CF_ACCOUNT_ID": "9bbac6865a80cafb336c82029cc7bb49",
    "CF_GATEWAY_ID": "zana-gateway",
    "VITE_FIREBASE_AUTH_DOMAIN": "gen-lang-client-0009572581.firebaseapp.com",
    "VITE_FIREBASE_PROJECT_ID": "gen-lang-client-0009572581",
    "VITE_FIREBASE_STORAGE_BUCKET": "gen-lang-client-0009572581.firebasestorage.app",
    "VITE_FIREBASE_API_KEY": "AIzaSyCGoc-gg1lQfsJziEUFyR6M48hXaUMKRkY",
    "VITE_FIREBASE_MEASUREMENT_ID": "G-RG8T98ZHBB",    "ZANA_REVISION": "172d195"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "02f342188c8740b0ada898c36791e4a3",
      "preview_id": "30c8a380662b489d85edc0dafc5b3858"
    },
    {
      "binding": "LEARNING_RECORDS_KV",
      "id": "a29b305980c94e169a741f4b29b9516e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ZANA_CURRICULUM_BUCKET",
      "bucket_name": "zana-curriculum"
    }
  ]
}