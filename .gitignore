# ==============================================================================
# ZANA Security & Secret Protection (.gitignore)
# Strict rules to prevent committing any API keys, credentials, tokens, or secrets
# ==============================================================================

# Environment files & Local configuration (Contains API keys and credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Cloudflare Wrangler sensitive files & secrets
.dev.vars
.dev.vars.*
.wrangler/

# Firebase & Google Cloud credentials and logs
service-account*.json
scripts/service-account.json
firebase-applet-config.json
firebase-debug.log
firebase-debug.*.log
.firebase/

# Cryptographic keys, certificates, and tokens
*.key
*.pem
*.crt
*.pfx
*.p12
*.cer
*.der
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.keystore
*.jks

# Secrets, private folders, and credentials
secrets/
*.secret
*.secrets
credentials/
private/
*.json.key

# Dependencies
node_modules/
bun.lock

# Build & Output directories
dist/
dist/client/
dist/server/
build/
coverage/

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backups & Archives
*.backup
*.backup-*
.backup-*/
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Operating System & IDE files
.DS_Store
Thumbs.db
.vscode/
.antigravity/
.idea/
*.swp
*.swo
